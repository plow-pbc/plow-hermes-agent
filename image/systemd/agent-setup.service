[Unit]
# Provider-neutral name for one job: whatever the VM host dropped in to inject
# tenant credentials before the gateway starts. /exe.dev/setup is exe.dev's
# hook and its path is that host's contract, so it cannot be renamed; another
# provider adds its own drop-in rather than renaming this unit.
Description=First-boot setup (tenant credential injection)
After=network-online.target
Wants=network-online.target
Before=hermes-gateway.service
ConditionPathExists=/exe.dev/setup
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/exe.dev/setup
ExecStartPost=/bin/rm -f /exe.dev/setup
[Install]
WantedBy=multi-user.target
