#!/bin/sh
# First boot, once, as root, before the gateway starts.
#
# This is the `plow-init` oneshot's `up`. Every service declares it as a
# dependency, so a non-zero exit starts nothing at all -- deliberate, because
# an agent whose setup half ran comes up looking healthy (the readiness probe
# only exercises the local API server) and is wrong in a way nobody sees.
set -eu

. /usr/local/lib/plow/root-path.sh

LC_ALL=C
export LC_ALL

# The whole of what a host tells this image: where Plow is, and what to present
# to it. root:root 0600 (0400 accepted, nothing looser) because this file
# decides where the agent's own bearer token is sent, and it is read while this
# script is still root.
PLOW_CREDENTIALS=/var/lib/plow/credentials

# The VM host's own setup hook. Its path is that host's to choose, so it cannot
# be renamed; another provider adds its own branch rather than renaming this
# one. It is removed once it has run, so a reboot cannot replay it.
if [ -x /exe.dev/setup ]; then
  /exe.dev/setup
  rm -f /exe.dev/setup
fi

# Unconditionally, and a second time on a host that already called it: every
# step is idempotent, and the last -- the home-mode restore -- is strictly
# better for running late.
/usr/local/lib/plow/first-boot.sh

# Read, never run: a dotenv is data, and `.` would hand every line of it a root
# shell. See /usr/local/lib/plow/dotenv.sh.
. /usr/local/lib/plow/dotenv.sh

# The names below are the image's to render, from the credential and from
# Plow's answer about the tenant holding it. An inherited PLOW_AGENT_TOKEN that
# outranked the file a host had just rewritten would be a rotation that
# silently did not take. HERMES_PROVIDER and HERMES_MODEL survive this and are
# the only names a container environment may contribute.
plow_drop_inherited

if [ -L "$PLOW_CREDENTIALS" ] || [ ! -f "$PLOW_CREDENTIALS" ]; then
  echo "plow-init: no credential at $PLOW_CREDENTIALS -- refusing to start a gateway nobody can reach" >&2
  exit 1
fi

# Anyone but root owning it, or able to read or write it, means whoever that is
# chooses both the API base and the token sent to it. Two exact modes rather
# than a rule about bits: a pattern excluding only the write bits admits 0644
# and 0620, one of which hands the credential to every uid on the box and the
# other the API base to a group.
plow_mode=$(stat -c '%u %g %a' "$PLOW_CREDENTIALS")
case "$plow_mode" in
  '0 0 600'|'0 0 400') ;;
  *)
    echo "plow-init: $PLOW_CREDENTIALS is uid/gid/mode '$plow_mode' -- expected root:root at 600 or 400" >&2
    exit 1
    ;;
esac
unset plow_mode

# Read here rather than copied, and BEFORE the home's own dotenv, which is what
# makes it authoritative: a name this file supplies is a name the persisted copy
# no longer gets to fill. The file is left in place afterwards -- rotation is a
# rewrite of these two lines and a restart, with no shell into the agent.
plow_load_dotenv "$PLOW_CREDENTIALS" "$PLOW_CREDENTIALS_ALLOWED" || exit 1
if [ -z "${PLOW_API_BASE:-}" ] || [ -z "${PLOW_AGENT_TOKEN:-}" ]; then
  echo "plow-init: $PLOW_CREDENTIALS must give both PLOW_API_BASE and PLOW_AGENT_TOKEN" >&2
  exit 1
fi

# The rest of the tenant's identity, asked of Plow with the tenant's own
# credential. The home channel can change without the token changing, and the
# relay URL is scoped to a device uid that appears nowhere in the file, so
# neither is derivable here. Asking on every boot is what keeps both current.
#
# Exit 0 with the answer, or one of two failures: TEMPORARY, meaning nobody
# said anything usable, and DEFINITIVE, meaning Plow answered that this
# credential is not usable, or answered with something that is not an identity.
# Only the first is worth retrying; neither is worth starting on.
plow_fetch_identity() {
  /opt/hermes/.venv/bin/python - <<'PLOW_IDENTITY_PY'
import json
import os
import re
import sys
import urllib.error
import urllib.request

TEMPORARY = 75   # EX_TEMPFAIL: retry, and fall back to a recorded identity
DEFINITIVE = 78  # EX_CONFIG: Plow answered; do not fall back on this


def fail(status, message):
    sys.stderr.write("plow-init: " + message + "\n")
    raise SystemExit(status)


base = os.environ["PLOW_API_BASE"].rstrip("/")
url = base + "/v1/agents/cloud/me"
request = urllib.request.Request(
    url,
    headers={
        "Authorization": "Bearer " + os.environ["PLOW_AGENT_TOKEN"],
        "Accept": "application/json",
    },
)
try:
    with urllib.request.urlopen(request, timeout=10) as response:
        raw = response.read()
except urllib.error.HTTPError as exc:
    # 401, 403 and 404 are Plow saying this credential is not this agent's --
    # revoked, or pointing at an agent that is gone. 429 and 5xx are "not now",
    # which is the same kind of silence as a dead socket.
    temporary = exc.code == 429 or 500 <= exc.code < 600
    fail(TEMPORARY if temporary else DEFINITIVE, "%s answered %s" % (url, exc.code))
except Exception as exc:  # noqa: BLE001 -- no answer at all, whatever the cause
    fail(TEMPORARY, "%s unreachable: %s" % (url, exc))

try:
    body = json.loads(raw)
    chat_uid = (body.get("chat_uid") or "").strip()
    mcp_url = (body.get("mcp_url") or "").strip()
except Exception as exc:  # noqa: BLE001
    fail(DEFINITIVE, "%s answered something that is not an identity: %s" % (url, exc))

# Both are written into a dotenv this script reads back, and one is a URL the
# agent hands its bearer token to. A newline would add a line to that file, and
# waiting does not make a malformed answer well formed.
if not re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", chat_uid):
    fail(DEFINITIVE, "%s answered with an unusable chat_uid: %r" % (url, chat_uid))
if mcp_url and not re.fullmatch(r"https?://[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]{1,512}", mcp_url):
    fail(DEFINITIVE, "%s answered with an unusable mcp_url: %r" % (url, mcp_url))

print("chat_uid=" + chat_uid)
print("mcp_url=" + mcp_url)
PLOW_IDENTITY_PY
}

# A VM's network is not always up when its first service is, and a restart
# races the same way, so silence is retried briefly. It is not survived: an
# agent that cannot be told who it is does not start, rather than start as
# whoever it was last time.
plow_try=1
while :; do
  plow_status=0
  plow_identity=$(plow_fetch_identity) || plow_status=$?
  [ "$plow_status" -eq 0 ] && break
  if [ "$plow_status" -ne 75 ]; then
    echo "plow-init: Plow refused this credential -- refusing to start" >&2
    exit 1
  fi
  if [ "$plow_try" -ge 10 ]; then
    echo "plow-init: gave up asking Plow who this agent is after $plow_try attempts -- refusing to start" >&2
    exit 1
  fi
  echo "plow-init: attempt $plow_try to reach Plow failed, retrying" >&2
  plow_try=$((plow_try + 1))
  sleep 3
done
unset plow_try plow_status

PLOW_HOME_CHANNEL=$(printf '%s\n' "$plow_identity" | sed -n 's/^chat_uid=//p')
export PLOW_HOME_CHANNEL
# An agent with no relay is a supported shape, and it is the ABSENCE of this
# name that plow-config reads as one -- never an empty value, which would be a
# third state neither reader has.
plow_mcp_url=$(printf '%s\n' "$plow_identity" | sed -n 's/^mcp_url=//p')
if [ -n "$plow_mcp_url" ]; then
  PLOW_MCP_URL=$plow_mcp_url
  export PLOW_MCP_URL
fi
unset plow_identity

# The image's inference key names an env var rather than holding a value, and
# the two are the same credential -- derived here rather than asked of a host
# that has no business knowing the provider block's shape.
HERMES_CUSTOM_PLOW_API_KEY=$PLOW_AGENT_TOKEN
export HERMES_CUSTOM_PLOW_API_KEY

# Only for the API_SERVER_KEY a previous boot persisted. Everything else here
# is already exported, so this fills nothing the file could overrule.
plow_load_dotenv /var/lib/hermes/.env || exit 1

# Plow is authoritative about the relay's ABSENCE too: a tenant whose relay went
# away would otherwise have it reinstated from the copy this home persisted.
if [ -z "$plow_mcp_url" ]; then
  unset PLOW_MCP_URL
fi
unset plow_mcp_url

# A VM has whatever timezone its host booted with, and every schedule the agent
# keeps is read in it. Last, so a TZ the operator persisted keeps its value.
if [ -z "${TZ:-}" ]; then
  TZ=UTC
  export TZ
fi

# The gateway's loopback API server will not start without a strong key, and
# without that listener there is nothing for readiness to find and nowhere for
# cron to deliver. Generated once and persisted below.
if [ -z "${API_SERVER_KEY:-}" ]; then
  API_SERVER_KEY=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
  export API_SERVER_KEY
fi

# Rewritten on every boot, which is what makes a rotated credential take: this
# file is the gateway's own authority, and a stale copy in a persisted volume is
# a revoked token the agent keeps presenting. It is also why uid 10000 never
# gets to create it -- a home the agent can write is a home where it could
# choose the API base its own bearer token is sent to.
umask 077
: > /var/lib/hermes/.env
# Verbatim, unquoted, one per line: the exact shape the parser reads back.
# Quoting would mean escaping, and escaping would mean interpreting.
for plow_key in PLOW_API_BASE PLOW_HOME_CHANNEL PLOW_AGENT_TOKEN \
                HERMES_CUSTOM_PLOW_API_KEY PLOW_MCP_URL API_SERVER_KEY TZ \
                HERMES_PROVIDER HERMES_MODEL; do
  plow_val=$(printenv "$plow_key" 2>/dev/null) || continue
  [ -n "$plow_val" ] || continue
  printf '%s=%s\n' "$plow_key" "$plow_val" >> /var/lib/hermes/.env
done
unset plow_key plow_val
chown root:hermes /var/lib/hermes/.env
chmod 0640 /var/lib/hermes/.env
echo "plow-init: wrote /var/lib/hermes/.env from $PLOW_CREDENTIALS" >&2

# Last, because it rewrites config.yaml and wants the ownership first-boot.sh
# has just settled.
/etc/s6-overlay/scripts/plow-config
