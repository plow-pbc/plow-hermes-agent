#!/command/with-contenv sh
# The Hermes gateway, supervised, as uid 10000.
#
# `with-contenv` is what makes one image serve both paths: it hands this script
# the container environment, which on a developer's machine is where the tenant
# values arrive (`env_file:`), and which on a VM is simply the image's own.
set -eu

# Set, not inherited: everything below runs as root, and PATH is one of the
# things a dotenv or a caller could otherwise choose for it.
PATH=/opt/hermes/bin:/opt/hermes/.venv/bin:/command:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# The dotenv the VM host wrote, if there is one. It wins over the container
# environment: on a VM it is the only source of tenant values, and a stale
# variable inherited from the image must not shadow the one provisioning just
# wrote. Nothing writes this file on the local path, where the container
# environment is the only source.
# Read, never run. This script is root until the `s6-setuidgid` below, and a
# dotenv is data: `.` would give every line of it a root shell.
. /usr/local/lib/plow/dotenv.sh
plow_load_dotenv /var/lib/hermes/.env || exit 1

# The only two values that differ from the image's own ENV. The gateway's API
# server is loopback-only: the agent's sole path to Plow is the outbound socket
# the plow_chat plugin opens, so there is nothing to expose. HERMES_HOME and
# the write guard are image ENV, not service ENV — the whole image agrees on
# one home.
export API_SERVER_HOST=127.0.0.1
export API_SERVER_PORT=8642

# with-contenv repopulates HOME from /init, which ran as root, so without this
# the gateway drops to uid 10000 still pointed at /root — a directory it cannot
# write. Anything HOME-anchored (a tool's cache, a library's config) then fails
# or silently lands somewhere the agent's own home does not include.
export HOME=/var/lib/hermes

cd /opt/hermes
exec /command/s6-setuidgid hermes \
  /opt/hermes/.venv/bin/hermes gateway run --replace --no-supervise
