#!/bin/sh
# Point the agent at its inference provider. The last step of the `plow-init`
# oneshot, which has already exported the tenant's values -- from the
# credential and from Plow -- and left HERMES_PROVIDER and HERMES_MODEL as the
# container environment set them.
#
# Only `model.provider` and `model.default` are written. Everything else the
# Plow provider needs -- its base_url, its key_env, its model list -- is baked
# into the image's config.yaml, tenant values left as `${...}` references that
# Hermes resolves from the environment. Switching provider is therefore one
# line in a dotenv, and switching back changes nothing else.
set -eu

. /usr/local/lib/plow/root-path.sh

CONFIG=/var/lib/hermes/config.yaml

# The publication seam, shared with the restore that runs before this.
. /usr/local/lib/plow/config-restore.sh

provider="${HERMES_PROVIDER:-plow}"
model="${HERMES_MODEL:-}"

# Both values are interpolated into a sed replacement below, so refuse anything
# that is not a plain provider or model id rather than letting it become part
# of the expression.
for value in "$provider" ${model:+"$model"}; do
  case "$value" in
    *[!A-Za-z0-9._:/-]*|"")
      echo "plow-config: refusing '$value' -- not a provider or model id" >&2
      exit 1
      ;;
  esac
done

# The image's own inference key names an env var rather than holding a value,
# and the two are the same credential. A dotenv that sets only the agent token
# would otherwise leave the key empty, which is not an error anywhere -- the
# gateway boots, answers nothing, and says why nowhere.
if [ "$provider" = plow ] && [ -z "${HERMES_CUSTOM_PLOW_API_KEY:-}" ] && [ -n "${PLOW_AGENT_TOKEN:-}" ]; then
  mkdir -p /run/s6/container_environment
  printf '%s' "$PLOW_AGENT_TOKEN" > /run/s6/container_environment/HERMES_CUSTOM_PLOW_API_KEY
fi

[ -f "$CONFIG" ] || exit 0

# first-boot restores a symlinked config before this runs, so reaching here
# with one means that ordering broke. The write below goes through the file
# rather than over it -- which is what keeps its ownership, and equally what
# would follow a link to somewhere else.
if [ -L "$CONFIG" ]; then
  echo "plow-config: $CONFIG is a symlink -- refusing to write through it" >&2
  exit 1
fi

# The relay server's enabled flag, rendered rather than remembered.
#
# Provisioning writes it once, at first boot, and then deletes itself -- so a
# config.yaml restored from the seed afterwards comes back with the relay OFF
# and the tenant's Latch tools silently gone, chat still working. The dotenv is
# the durable record of whether this agent has a relay at all, so the flag is
# derived from it on every boot: present means on, absent means off, which is
# exactly what the provisioner decided (it renders the
# same boolean from the same value). Idempotent, and a no-op on the local path,
# where there is no relay and the seed already says false.
if [ -n "${PLOW_MCP_URL:-}" ]; then
  plow_mcp_enabled=true
else
  plow_mcp_enabled=false
fi

# Scoped to the `model:` block: `provider` and `default` are common key names
# and an unscoped substitution would reach the ones under `providers:`. A key
# the block does not carry is inserted rather than skipped -- a home volume
# carries the config.yaml Hermes last wrote, not the one the image seeded, and
# Hermes drops keys it considers defaults.
model_block() { sed -n '/^model:$/,/^[^ ]/p' "$1"; }

set_key() {   # set_key <file> <key> <value>
  if ! grep -q '^model:$' "$1"; then
    printf 'model:\n  %s: %s\n' "$2" "$3" >> "$1"
  elif model_block "$1" | grep -q "^  $2: "; then
    sed -i "/^model:\$/,/^[^ ]/ s|^  $2: .*|  $2: $3|" "$1"
  else
    sed -i "/^model:\$/a\\  $2: $3" "$1"
  fi
}

# Published the same way a restore is: staged beside the target, given its mode
# and owner there, then renamed on. Writing the bytes back through the live file
# kept its ownership -- which is what config.yaml needs, since a root-owned one
# is the one the plow_chat plugin cannot persist its home channel through -- but
# it truncated the inode first, so an interruption left a partial config that
# every boot guard accepts. Setting the ownership on the staged copy gets the
# same outcome without the window. Skipped entirely when nothing changed, so a
# reboot leaves the file byte-identical, mtime included.
staged="$(mktemp)"
cat "$CONFIG" > "$staged"
set_key "$staged" provider "$provider"
if [ -n "$model" ]; then set_key "$staged" default "$model"; fi
# Scoped to mcp_servers.plow and to the one key. Not a sed range: `  plow:` is
# also a key under `providers:`, and a range over the whole mcp_servers block
# would set `enabled:` on every server in it -- including one an operator added
# for something else entirely.
awk -v flag="$plow_mcp_enabled" '
  /^[^ ]/          { in_mcp = ($0 == "mcp_servers:") }
  in_mcp && /^  [^ ]/ { in_plow = ($0 == "  plow:") }
  in_mcp && in_plow && /^    enabled: / { print "    enabled: " flag; next }
                   { print }
' "$staged" > "$staged.mcp" && mv -f "$staged.mcp" "$staged"
if ! cmp -s "$staged" "$CONFIG"; then
  plow_publish_config "$staged"
  echo "plow-config: model.provider=${provider}${model:+ model.default=${model}} mcp_servers.plow.enabled=${plow_mcp_enabled}" >&2
fi
rm -f "$staged"
