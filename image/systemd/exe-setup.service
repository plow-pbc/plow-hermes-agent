[Unit]
Description=exe.dev first-boot setup (tenant credential injection)
After=network-online.target
Wants=network-online.target
Before=hermes-gateway.service
ConditionPathExists=/exe.dev/setup
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/exe.dev/setup
ExecStartPost=/bin/rm -f /exe.dev/setup
[Install]
WantedBy=multi-user.target
