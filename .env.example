# This agent's credentials and where it talks. `plow-activate` writes all five;
# see the README. Never commit the filled-in copy.

# The Plow API root, WITHOUT /v1 -- the plow_chat plugin appends its own.
PLOW_API_BASE=https://api.plow.co
# The chat the agent calls home, and where its scheduled work is delivered.
PLOW_HOME_CHANNEL=
# The agent's own credential: its chats and its inference, nothing else.
PLOW_AGENT_TOKEN=
# The same token again. config.yaml names the inference key by env var, and an
# empty one is an outage the gateway reports nowhere.
HERMES_CUSTOM_PLOW_API_KEY=
# Where inference goes. Any Hermes provider works; see "Change inference
# provider" in the README.
HERMES_PROVIDER=plow
