#!/bin/sh
# A compatibility shim, not an init interface.
#
# Plow's credential update and its rollback shell into the VM and run
# `systemctl restart --no-block hermes-gateway`. That was this image's contract
# while systemd was PID 1; it is s6 now, and those callers live in another
# repository on their own release cycle. Rather than break them, this accepts
# exactly the one command line they send and hands it to the real thing.
#
# It answers nothing else. A shim that quietly returned 0 for `status`,
# `enable` or any other unit would let a caller believe an operation happened,
# and that is worse than an error naming the replacement.
#
# Delete this file once plow.git calls plow-restart-gateway directly.
set -eu

# --no-block is accepted and ignored: the replacement waits for the gateway to
# be answering again, which is what its callers actually need — the update
# verifies the new credential against the running process, and a restart that
# returned early would let it verify the old one.
args=""
for arg in "$@"; do
  [ "$arg" = "--no-block" ] && continue
  args="$args $arg"
done

case "$args" in
  " restart hermes-gateway")
    exec /usr/local/bin/plow-restart-gateway
    ;;
esac

cat >&2 <<USAGE
systemctl: this image has no systemd; PID 1 is s6-overlay.
Only "systemctl restart hermes-gateway" is bridged, and it is a shim for:

    plow-restart-gateway

Refused:$args
USAGE
exit 1
